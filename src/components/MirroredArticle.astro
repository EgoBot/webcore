---
/**
 * MirroredArticle — drop-in Astro component that fetches a remote page at
 * build time and renders the inner HTML of its <article> tag.
 *
 * Usage in a consumer page:
 *
 *   <MirroredArticle url="https://theodysseypath.com/privacy/" fallback="<p>...</p>" />
 *
 * Style the surrounding container in the consumer; this component emits
 * raw HTML inside a <div class="mirrored-article"> hook so consumers can
 * scope their CSS.
 */
import { fetchMirroredArticle, type MirrorOptions } from '../utils/mirror-content';

interface Props extends MirrorOptions {
  url: string;
  className?: string;
}

const { url, className = 'mirrored-article', ...opts } = Astro.props as Props;
const result = await fetchMirroredArticle(url, opts);
---
<div
  class={className}
  data-mirror-source={result.source}
  data-mirror-fallback={result.fromFallback ? 'true' : undefined}
  set:html={result.html}
></div>
